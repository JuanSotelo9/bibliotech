# ===========================================
# Bibliotech - Variables de Entorno
# ===========================================
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env
# ===========================================

# --- Base de Datos (PostgreSQL) ---
DB_NAME=LibreriaDB
DB_USER=postgres
DB_PASSWORD=cambia_esta_contraseña
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000

# --- JWT ---
# Usa al menos 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia_esta_clave_jwt_por_una_segura_de_al_menos_32_caracteres

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Zona Horaria ---
TZ=America/Bogota
